# ===== LLM =====
# mock: 无需 API key 的确定性模式（CI/演示用）；deepseek: 真实调用
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 任意 OpenAI 兼容服务亦可：改 BASE_URL + MODEL 即可
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ===== 数据 =====
# 数据生成：固定种子保证评测可复现
DB_PATH=data/askbi.duckdb
GENERATOR_SEED=42
GENERATOR_MONTHS=24          # 生成多少个月的数据
GENERATOR_END_MONTH=2026-09  # 数据截止（完整月），固定以保证评测稳定

# ===== 安全 =====
SQL_TIMEOUT_SECONDS=10
# 注（ASKBI-4）：ROLE 曾文档化为「环境级行级权限角色」但全仓零消费——已删。
# 行级权限的合法入口是请求体 role 字段（boss=全区域, south=仅华南，演示权限隔离）。

# ===== 编排 =====
MAX_SQL_REPAIRS=2            # SQL 执行失败的修复重试上限
MAX_QA_REVISIONS=2           # QA 打回的修订循环上限
RAG_BACKEND=tfidf            # tfidf | chroma
RAG_TOPK=3

# ===== 服务 =====
# 留空则不启用鉴权；设置后所有 /api 请求需带 X-API-Key
API_KEY=
